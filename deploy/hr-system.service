[Unit]
Description=HR System Backend (.NET 8)
After=network.target

[Service]
Type=notify
WorkingDirectory=/var/www/hr-system
ExecStart=/usr/bin/dotnet HrSystem.Backend.dll
Restart=always
RestartSec=5
SyslogIdentifier=hr-system
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://+:5000

# Security hardening
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target